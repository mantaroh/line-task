{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "line-task-board",
  "account_id": "00000000000000000000000000000000",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "dist/client/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "line-task-board", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "11111111111111111111111111111111" }],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "line-task-board-images" }],
  "triggers": { "crons": ["0 0 * * *"] },
  "observability": { "enabled": true },
  "route": { "pattern": "tasks.example.com", "custom_domain": true },
  "vars": { "LINE_CHANNEL_ID": "1234567890", "APP_URL_BASE": "https://liff.line.me/1234567890-abcdefgh", "LINE_OA_BASIC_ID": "@example" }
}
